# ---------------------------------------------------------------------------
# CyberSafe local configuration
# Copy this file to `.env` and fill in your own values. Never commit `.env`.
# ---------------------------------------------------------------------------

# development | production
NODE_ENV=development

# Local server
HOST=127.0.0.1
PORT=3000
APP_BASE_URL=http://localhost:3000

# SQLite file (relative paths resolve from the project root).
# The data/ directory is git-ignored.
DATABASE_FILE=data/cybersafe.db

# ---------------------------------------------------------------------------
# Google OpenID Connect
# Create an OAuth 2.0 Client ID of type "Web application" in Google Cloud
# Console and add the authorized redirect URI shown below.
# https://console.cloud.google.com/apis/credentials
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Leave as the default unless you use a Google-compatible test issuer.
GOOGLE_ISSUER=https://accounts.google.com

# ---------------------------------------------------------------------------
# Sessions
# Opaque server-side sessions; the cookie only carries a random token.
# ---------------------------------------------------------------------------
SESSION_TTL_HOURS=12
# Defaults to true when NODE_ENV=production. Must stay true in production.
SESSION_COOKIE_SECURE=false
# Set to true when the app runs behind a trusted reverse proxy (HTTPS hosting).
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Development-only helpers (the hidden POST /auth/dev-login route used by
# tests and automation, plus `npm run setup-test-accounts`). No development
# UI is shown on the sign-in page. Refused automatically when
# NODE_ENV=production.
# ---------------------------------------------------------------------------
AUTH_DEV_MODE=true

# ---------------------------------------------------------------------------
# Rate limiting for sign-in and API endpoints
# ---------------------------------------------------------------------------
RATE_LIMIT_AUTH_WINDOW_MINUTES=10
RATE_LIMIT_AUTH_MAX=20
