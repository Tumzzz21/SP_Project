<%- include('../partials/head') %>

<main id="main" class="shell page">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/quizzes">Quizzes</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page"><%= quiz.title %></span>
  </nav>

  <header class="page-head">
    <div>
      <p class="eyebrow"><%= adminView ? 'Quiz preview' : 'Quiz' %></p>
      <h1><%= quiz.title %></h1>
      <p class="muted"><%= quiz.description %></p>
    </div>
  </header>

  <% if (adminView) { %>
    <div class="notice notice-info">
      <p>
        <strong>Administrator preview.</strong>
        Correct answers and explanations are stored on the server and are not sent to the browser.
        Student attempts are graded server-side; admin accounts cannot take student quizzes.
      </p>
    </div>

    <p class="muted">
      <%= questions.length %> question<%= questions.length === 1 ? '' : 's' %>
      <span aria-hidden="true">·</span> Version <%= quiz.version %>
      <span aria-hidden="true">·</span> Pass mark <%= quiz.passingScorePercent %>%
    </p>

    <ol class="question-list">
      <% questions.forEach(function (question) { %>
        <li class="question-card">
          <p class="question-prompt"><span class="question-number"><%= question.position %></span><%= question.prompt %></p>
          <ul class="option-list">
            <% question.options.forEach(function (option) { %>
              <li class="option">
                <span class="option-marker" aria-hidden="true"></span>
                <span><%= option.label %></span>
              </li>
            <% }); %>
          </ul>
        </li>
      <% }); %>
    </ol>

    <div class="page-actions">
      <a class="btn btn-secondary" href="/quizzes">Back to quizzes</a>
      <a class="btn btn-primary" href="/admin">Admin dashboard</a>
    </div>
  <% } else { %>
    <div class="quiz-overview">
      <div class="panel">
        <h2>Before you start</h2>
        <ul class="detail-list detail-list-compact">
          <li><span class="detail-label">Questions</span><span><%= questions.length %></span></li>
          <li><span class="detail-label">Version</span><span><%= quiz.version %></span></li>
          <li><span class="detail-label">Your attempts</span><span><%= stats.total %></span></li>
          <li>
            <span class="detail-label">Best score</span>
            <span><%= bestPercentage === null ? 'No completed attempt yet' : bestPercentage + '%' %></span>
          </li>
        </ul>
        <p class="muted">
          Answers are graded on the server. Correct answers and explanations appear only after
          you submit. Leaving a question blank counts as incorrect.
        </p>

        <% if (availability === 'ready') { %>
          <% if (openAttempt) { %>
            <div class="notice notice-warning">
              <p><strong>You have an attempt in progress.</strong></p>
              <p class="muted">Continue it, or finish it before starting another attempt.</p>
            </div>
            <div class="page-actions">
              <a class="btn btn-primary" href="/attempts/<%= openAttempt.id %>">Resume attempt</a>
            </div>
          <% } else { %>
            <form method="post" action="/quizzes/<%= quiz.slug %>/attempt" data-pending-form>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-primary" type="submit">
                <%= stats.total > 0 ? 'Start a new attempt' : 'Start quiz' %>
              </button>
            </form>
          <% } %>
        <% } else if (availability === 'empty') { %>
          <div class="notice notice-warning">
            <p><strong>This quiz has no questions yet.</strong></p>
            <p class="muted">An administrator needs to add questions before it can be taken.</p>
          </div>
        <% } else { %>
          <div class="notice notice-warning">
            <p><strong>This quiz is not ready to be taken.</strong></p>
            <p class="muted">Its questions need exactly one correct option each before grading is possible.</p>
          </div>
        <% } %>

        <p class="muted">
          <a class="link-arrow" href="/quizzes/history">View your quiz history <span aria-hidden="true">→</span></a>
        </p>
      </div>

      <% if (attempts.length > 0) { %>
        <div class="panel panel-muted">
          <h2>Your past attempts</h2>
          <ul class="attempt-mini-list">
            <% attempts.slice(0, 3).forEach(function (entry) { %>
              <li>
                <span>
                  <a href="/attempts/<%= entry.id %>">
                    <%= formatDateTime(entry.submittedAt || entry.startedAt) %>
                  </a>
                  <% if (entry.status === 'expired') { %><span class="badge badge-warning">Expired</span><% } %>
                </span>
                <span class="muted">
                  <%= entry.status === 'submitted' ? entry.scorePoints + '/' + entry.maxPoints + ' · ' + entry.percentage + '%' : 'Not completed' %>
                </span>
              </li>
            <% }); %>
          </ul>
          <a class="link-arrow" href="/quizzes/history">Full history <span aria-hidden="true">→</span></a>
        </div>
      <% } %>
    </div>
  <% } %>
</main>

<%- include('../partials/footer') %>
