<%
  const questionCount = quiz.questionCount === undefined ? (counts.get(quiz.id) || 0) : quiz.questionCount;
  const hasBest = !adminView && quiz.bestPercentage !== null && quiz.bestPercentage !== undefined;
  const attemptState = hasBest ? 'completed' : 'not-attempted';
  const actionLabel = quiz.openAttemptId ? 'Resume' : hasBest ? 'Review' : 'Start quiz';
  const bestLabel = hasBest ? `Best ${quiz.bestScorePoints}/${quiz.bestMaxPoints}` : 'Not attempted';
  const searchText = `${quiz.title || ''} ${quiz.description || ''} ${quiz.slug || ''}`.toLowerCase();
  const statusLabel = quiz.status.charAt(0).toUpperCase() + quiz.status.slice(1);
%>
<li
  class="quiz-tile"
  data-quiz-card
  data-quiz-status="<%= quiz.status %>"
  data-quiz-slug="<%= quiz.slug %>"
  data-quiz-attempt="<%= attemptState %>"
  data-quiz-search="<%= searchText %>"
>
  <div class="quiz-card-top">
    <span class="quiz-topic-icon" aria-hidden="true">
      <%- include('../partials/icon', { name: quiz.topicIcon, size: 24 }) %>
    </span>
    <% if (adminView) { %>
      <div class="quiz-card-tools">
        <span class="quiz-status-chip quiz-status-chip--<%= quiz.status %>"><%= statusLabel %></span>
        <div class="quiz-menu" data-quiz-menu>
          <button
            type="button"
            class="quiz-menu-toggle"
            aria-expanded="false"
            aria-haspopup="menu"
            aria-controls="quiz-menu-<%= quiz.id %>"
            aria-label="More actions for <%= quiz.title %>"
            data-quiz-menu-toggle
          >
            <%- include('../partials/icon', { name: 'more', size: 20 }) %>
          </button>
          <div class="quiz-menu-panel" id="quiz-menu-<%= quiz.id %>" role="menu" hidden>
            <% if (quiz.status === 'archived') { %>
              <form method="post" action="/admin/quizzes/<%= quiz.id %>/restore" class="quiz-menu-form" data-quiz-action="restore">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <input type="hidden" name="returnTo" value="/quizzes">
                <button class="quiz-menu-item" role="menuitem" type="submit">Restore</button>
              </form>
              <a class="quiz-menu-item" role="menuitem" href="/admin/quizzes/<%= quiz.id %>/preview" data-quiz-action="preview">Preview</a>
              <form method="post" action="/admin/quizzes/<%= quiz.id %>/delete" class="quiz-menu-form"
                    data-quiz-action="delete"
                    data-confirm="Delete &quot;<%= quiz.title %>&quot; v<%= quiz.version %>? This cannot be undone. Versions with student attempts cannot be deleted.">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <input type="hidden" name="returnTo" value="/quizzes?filter=archived">
                <button class="quiz-menu-item quiz-menu-item--danger" role="menuitem" type="submit">Delete</button>
              </form>
            <% } else { %>
              <a class="quiz-menu-item" role="menuitem" href="/admin/quizzes/<%= quiz.id %>" data-quiz-action="edit">Edit</a>
              <a class="quiz-menu-item" role="menuitem" href="/admin/quizzes/<%= quiz.id %>/preview" data-quiz-action="preview">Preview</a>
              <% if (quiz.status === 'published') { %>
                <form method="post" action="/admin/quizzes/<%= quiz.id %>/archive" class="quiz-menu-form" data-quiz-action="archive">
                  <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                  <input type="hidden" name="returnTo" value="/quizzes?filter=archived#archived">
                  <button class="quiz-menu-item" role="menuitem" type="submit">Archive</button>
                </form>
              <% } else if (quiz.status === 'draft') { %>
                <form method="post" action="/admin/quizzes/<%= quiz.id %>/publish" class="quiz-menu-form" data-quiz-action="publish">
                  <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                  <input type="hidden" name="returnTo" value="/quizzes">
                  <button class="quiz-menu-item" role="menuitem" type="submit">Publish</button>
                </form>
              <% } %>
            <% } %>
          </div>
        </div>
      </div>
    <% } %>
  </div>

  <h3 class="quiz-card-title"><%= quiz.title %></h3>
  <p class="quiz-card-desc"><%= quiz.description %></p>

  <div class="quiz-card-meta">
    <span class="quiz-meta-item">
      <%- include('../partials/icon', { name: 'list', size: 16 }) %>
      <span><%= questionCount %> question<%= questionCount === 1 ? '' : 's' %></span>
    </span>
    <span class="quiz-meta-item">
      <%- include('../partials/icon', { name: 'target', size: 16 }) %>
      <span>Pass <%= quiz.passingScorePercent %>%</span>
    </span>
    <% if (adminView) { %><span class="quiz-version">v<%= quiz.version %></span><% } %>
  </div>

  <% if (!adminView) { %>
    <span class="quiz-attempt-chip quiz-attempt-chip--<%= attemptState %>"><%= bestLabel %></span>
  <% } %>

  <div class="quiz-card-footer">
    <% if (adminView) { %>
      <a class="btn btn-primary btn-sm quiz-card-cta" href="/admin/quizzes/<%= quiz.id %>/preview">Preview</a>
    <% } else { %>
      <a class="btn btn-primary btn-sm quiz-card-cta" href="/quizzes/<%= quiz.slug %>"><%= actionLabel %></a>
    <% } %>
  </div>
</li>
