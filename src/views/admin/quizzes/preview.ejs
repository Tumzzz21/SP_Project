<%- include('../../partials/head') %>

<main id="main" class="shell page">
  <%- include('../../partials/flash') %>

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/admin/quizzes">Quizzes</a>
    <span aria-hidden="true">/</span>
    <a href="/admin/quizzes/<%= quiz.id %>"><%= quiz.title %> v<%= quiz.version %></a>
    <span aria-hidden="true">/</span>
    <span>Preview</span>
  </nav>

  <header class="page-head">
    <div>
      <p class="eyebrow">Admin preview · Version <%= quiz.version %> · Pass at <%= quiz.passingScorePercent %>%</p>
      <h1><%= quiz.title %></h1>
      <p class="muted"><%= quiz.description || 'No description.' %></p>
    </div>
    <div class="page-head-actions">
      <span class="badge badge-<%= quiz.status === 'published' ? 'success' : (quiz.status === 'archived' ? 'danger' : 'outline') %>"><%= quiz.status %></span>
      <a class="btn btn-secondary btn-sm" href="/admin/quizzes/<%= quiz.id %>">Back to edit</a>
    </div>
  </header>

  <div class="notice notice-info" role="status">
    This is exactly what students see: answer choices only. Correct answers and explanations are never
    sent to the browser before an attempt is submitted — check the edit page for the answer key.
  </div>

  <% if (questions.length === 0) { %>
    <div class="empty-state">
      <h3>No questions yet</h3>
      <p class="muted">This version has no questions. Add some on the edit page.</p>
    </div>
  <% } else { %>
    <div class="question-stack">
      <% questions.forEach(function (question, i) { %>
        <%- include('../../partials/question-preview', { question: question, index: i }) %>
      <% }); %>
    </div>
  <% } %>
</main>

<%- include('../../partials/footer') %>
