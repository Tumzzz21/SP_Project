<%- include('../../partials/head') %>

<main id="main" class="shell page">
  <%- include('../../partials/flash') %>

  <header class="page-head">
    <div>
      <p class="eyebrow">Admin · Assessment</p>
      <h1>Attempt review</h1>
      <p class="muted">
        Read-only. Every attempt is graded server-side at submission and stored immutably —
        this page cannot change scores.
      </p>
    </div>
  </header>


  <section class="section-tight">
    <% if (!quizzes || quizzes.length === 0) { %>
      <div class="empty-state">
        <h3>No quizzes yet</h3>
        <p class="muted">Published quizzes will appear here with submission stats.</p>
      </div>
    <% } else { %>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">Quiz</th>
              <th scope="col">Status</th>
              <th scope="col">Submissions</th>
              <th scope="col">Unique students</th>
              <th scope="col">Avg score</th>
              <th scope="col"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            <% quizzes.forEach(function (q) { %>
              <tr>
                <td><strong><%= q.title %></strong><br><span class="muted small">v<%= q.version %></span></td>
                <td><%= q.status %></td>
                <td><%= q.totalSubmissions %></td>
                <td><%= q.uniqueStudents %></td>
                <td><%= q.avgScore %>%</td>
                <td><a class="btn btn-primary btn-sm" href="/admin/quizzes/<%= q.id %>/submissions">View submissions</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</main>

<%- include('../../partials/footer') %>
