<%- include('../../partials/head') %>

<main id="main" class="shell page">
  <%- include('../../partials/flash') %>

  <header class="page-head">
    <div>
      <p class="eyebrow">Admin · Assessment</p>
      <h1>Attempt review</h1>
      <p class="muted">
        Read-only. Every attempt is graded server-side at submission and stored immutably —
        this page cannot change scores.
      </p>
    </div>
  </header>

  <section class="section-tight">
    <% if (attempts.length === 0) { %>
      <div class="empty-state">
        <h3>No attempts yet</h3>
        <p class="muted">Submitted and expired attempts appear here, newest first, once students take a quiz.</p>
      </div>
    <% } else { %>
      <div class="table-wrap">
        <table class="data-table">
          <caption class="sr-only">Quiz attempts, newest first</caption>
          <thead>
            <tr>
              <th scope="col">Student</th>
              <th scope="col">Quiz version</th>
              <th scope="col">Score</th>
              <th scope="col">Status</th>
              <th scope="col">Submitted</th>
              <th scope="col"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            <% attempts.forEach(function (attempt) { %>
              <tr>
                <td>
                  <strong><%= attempt.studentName || '—' %></strong><br>
                  <span class="muted small"><%= attempt.studentEmail %></span>
                </td>
                <td><%= attempt.title %> <span class="muted">v<%= attempt.version %></span></td>
                <td>
                  <% if (attempt.status === 'submitted') { %>
                    <strong><%= attempt.scorePoints %>/<%= attempt.maxPoints %></strong>
                  <% } else { %>
                    —
                  <% } %>
                </td>
                <td><span class="badge badge-<%= attempt.status === 'submitted' ? 'success' : 'warning' %>"><%= attempt.status %></span></td>
                <td><%= formatDateTime(attempt.submittedAt || attempt.startedAt) %></td>
                <td><a class="link-arrow" href="/admin/attempts/<%= attempt.id %>">Review</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</main>

<%- include('../../partials/footer') %>
