<%- include('../partials/head') %>

<main id="main" class="shell page">
  <%- include('../partials/flash') %>

  <header class="page-head">
    <div>
      <p class="eyebrow">Administrator</p>
      <h1>Admin overview</h1>
      <p class="muted">Manage modules, quizzes, and review user attempts.</p>
    </div>
  </header>

  <!-- Quick access cards -->
  <section class="stat-grid" aria-label="Quick access">
    <a href="/admin/modules" class="stat-card stat-card--green">
      <div class="stat-head">
        <span class="stat-icon" aria-hidden="true"><%- include('../partials/icon', { name: 'modules', size: 20 }) %></span>
        <p class="stat-label">Modules</p>
      </div>
      <p class="stat-value"><%= moduleCounts.total %><span class="stat-suffix"></span></p>
      <p class="muted">Create, edit, publish modules</p>
    </a>
    <a href="/admin/quizzes" class="stat-card stat-card--cyan">
      <div class="stat-head">
        <span class="stat-icon" aria-hidden="true"><%- include('../partials/icon', { name: 'quizzes', size: 20 }) %></span>
        <p class="stat-label">Quizzes</p>
      </div>
      <p class="stat-value"><%= quizCounts.total %><span class="stat-suffix"></span></p>
      <p class="muted">Create, publish, archive quizzes</p>
    </a>
    <a href="/admin/users" class="stat-card stat-card--blue">
      <div class="stat-head">
        <span class="stat-icon" aria-hidden="true"><%- include('../partials/icon', { name: 'users', size: 20 }) %></span>
        <p class="stat-label">Users</p>
      </div>
      <p class="stat-value"><%= userCounts.total %><span class="stat-suffix"></span></p>
      <p class="muted">Manage accounts and roles</p>
    </a>
    <a href="/admin/users" class="stat-card stat-card--amber">
      <div class="stat-head">
        <span class="stat-icon" aria-hidden="true"><%- include('../partials/icon', { name: 'trophy', size: 20 }) %></span>
        <p class="stat-label">Users</p>
      </div>
      <p class="stat-value"><%= studentCounts.active %><span class="stat-suffix"></span></p>
      <p class="muted">View user progress and status</p>
    </a>
    <a href="/admin/attempts" class="stat-card stat-card--rose">
      <div class="stat-head">
        <span class="stat-icon" aria-hidden="true"><%- include('../partials/icon', { name: 'shield', size: 20 }) %></span>
        <p class="stat-label">Attempt review</p>
      </div>
      <p class="stat-value"><%= attemptCounts.total %><span class="stat-suffix"></span></p>
      <p class="muted">Review submitted quiz attempts</p>
    </a>

    <div class="stat-card stat-card--green">
      <div class="stat-head">
        <span class="stat-icon" aria-hidden="true"><%- include('../partials/icon', { name: 'users', size: 20 }) %></span>
        <p class="stat-label">ACTIVE USERS</p>
      </div>
      <p class="stat-value"><%= studentCounts.active %></p>
      <p class="muted"><%= studentCounts.pendingSetup %> awaiting setup · <%= studentCounts.disabled %> disabled</p>
    </div>

    <div class="stat-card stat-card--cyan">
      <div class="stat-head">
        <span class="stat-icon" aria-hidden="true"><%- include('../partials/icon', { name: 'modules', size: 20 }) %></span>
        <p class="stat-label">PUBLISHED MODULES</p>
      </div>
      <p class="stat-value"><%= moduleCounts.published %></p>
      <p class="muted"><%= moduleCounts.draft %> draft<%= moduleCounts.draft === 1 ? '' : 's' %> · <%= moduleCounts.archived %> archived</p>
    </div>

    <div class="stat-card stat-card--blue">
      <div class="stat-head">
        <span class="stat-icon" aria-hidden="true"><%- include('../partials/icon', { name: 'quizzes', size: 20 }) %></span>
        <p class="stat-label">PUBLISHED QUIZZES</p>
      </div>
      <p class="stat-value"><%= quizCounts.published %></p>
      <p class="muted"><%= quizCounts.draft %> draft<%= quizCounts.draft === 1 ? '' : 's' %> · <%= quizCounts.archived %> archived</p>
    </div>

    <div class="stat-card stat-card--amber">
      <div class="stat-head">
        <span class="stat-icon" aria-hidden="true"><%- include('../partials/icon', { name: 'trophy', size: 20 }) %></span>
        <p class="stat-label">AVERAGE SCORE</p>
      </div>
      <% if (participation.averagePercent === null || participation.averagePercent === undefined) { %>
        <p class="stat-value">—</p>
        <p class="muted">No submitted attempts yet.</p>
      <% } else { %>
        <p class="stat-value"><%= participation.averagePercent %><span class="stat-suffix">%</span></p>
        <p class="muted"><%= participation.participants %> participant<%= participation.participants === 1 ? '' : 's' %> · <%= participation.submittedAttempts %> attempt<%= participation.submittedAttempts === 1 ? '' : 's' %></p>
      <% } %>
    </div>
  </section>



  <!-- Latest user attempts -->
  <section class="section-tight">
    <div class="section-head-inline">
      <h2>Latest user attempts</h2>
      <a class="link-arrow" href="/admin/attempts">All attempts <span aria-hidden="true">&rarr;</span></a>
    </div>
    <%- include('../partials/quiz-attempts-list', { attempts: recentAttempts, scope: 'all', emptyTitle: 'No attempts yet', emptyMessage: 'No user attempts have been submitted yet.', ctaHref: null, ctaLabel: null }) %>
  </section>

<%- include('../partials/footer') %>
