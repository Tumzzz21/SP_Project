<%- include('../partials/head') %>

<main id="main" class="shell page">
  <%- include('../partials/flash') %>

  <header class="page-head">
    <div>
      <p class="eyebrow">Administrator</p>
      <h1>Admin overview</h1>
      <p class="muted">
        Signed in as <%= user.displayName %> (<%= user.email %>). Live counts from the database —
        the selection and the sections below are the entry points to the rest of the admin tools.
      </p>
    </div>
  </header>

  <%- include('../partials/admin-tabs') %>

  <section class="stat-grid" aria-label="Platform totals">
    <div class="stat-card">
      <p class="stat-label">Active students</p>
      <p class="stat-value"><%= studentCounts.active %></p>
      <p class="muted"><%= studentCounts.pendingSetup %> awaiting setup · <%= studentCounts.disabled %> disabled</p>
    </div>
    <div class="stat-card">
      <p class="stat-label">Published lessons</p>
      <p class="stat-value"><%= lessonCounts.published %></p>
      <p class="muted"><%= lessonCounts.draft %> draft<%= lessonCounts.draft === 1 ? '' : 's' %> · <%= lessonCounts.archived %> archived</p>
    </div>
    <div class="stat-card">
      <p class="stat-label">Published quiz versions</p>
      <p class="stat-value"><%= quizCounts.published %></p>
      <p class="muted"><%= quizCounts.draft %> draft · <%= quizCounts.archived %> archived</p>
    </div>
    <div class="stat-card">
      <p class="stat-label">Quiz participation</p>
      <p class="stat-value"><%= participation.participants %></p>
      <p class="muted">
        <% if (participation.submittedAttempts > 0) { %>
          student<%= participation.participants === 1 ? '' : 's' %> · <%= participation.submittedAttempts %> submitted attempt<%= participation.submittedAttempts === 1 ? '' : 's' %> · average score <%= participation.averagePercent %>% across submitted work
        <% } else { %>
          No submitted attempts yet
        <% } %>
      </p>
    </div>
  </section>
  <section class="section-tight">
    <div class="section-head section-head-inline">
      <h2>Selection</h2>
      <span class="muted">Pick a focus area</span>
    </div>

    <div class="split section-tight">
      <div class="panel">
        <div class="section-head section-head-inline">
          <h2>Lessons</h2>
          <a class="link-arrow" href="/admin/lessons">Manage lessons</a>
        </div>
        <% if (lessons.length === 0) { %>
          <p class="muted">No lessons have been created yet. Run <code>npm run db:seed</code> for the sample curriculum.</p>
        <% } else { %>
          <ul class="admin-list">
            <% lessons.forEach(function (lesson) { %>
              <li>
                <span><%= lesson.title %></span>
                <span class="badge badge-<%= lesson.status === 'published' ? 'success' : 'outline' %>"><%= lesson.status %></span>
              </li>
            <% }); %>
          </ul>
        <% } %>
        <p class="muted small"><a class="link-arrow" href="/admin/lessons/new">Create a lesson</a></p>
      </div>

      <div class="panel">
        <div class="section-head section-head-inline">
          <h2>Quizzes</h2>
          <a class="link-arrow" href="/admin/quizzes">Manage quizzes</a>
        </div>
        <% if (quizzes.length === 0) { %>            <p class="muted">No quizzes are published yet — the first one can be created from the manage quizzes page.</p>
        <% } else { %>
          <ul class="admin-list">
            <% quizzes.forEach(function (quiz) { %>
              <li>
                <span><%= quiz.title %> <span class="muted">v<%= quiz.version %></span></span>
                <a class="link-arrow" href="/admin/quizzes/<%= quiz.id %>">Edit</a>
              </li>
            <% }); %>
          </ul>
        <% } %>
        <p class="muted small"><a class="link-arrow" href="/admin/quizzes/new">Create a quiz</a></p>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="section-head section-head-inline">
      <h2>Manage lesson</h2>
      <a class="link-arrow" href="/admin/lessons">Manage lessons</a>
    </div>
    <p class="muted">
      Every lesson you create gets a private draft the student never sees. Publish a lesson only when the explanations and checkpoint questions are stable, and use archived lessons to retire outdated material without losing the record.
    </p>
  </section>

  <section class="section-tight">
    <div class="section-head section-head-inline">
      <h2>Lesson quiz</h2>
      <a class="link-arrow" href="/admin/quizzes">Manage quizzes</a>
    </div>
    <p class="muted">
      Each published lesson may carry one linked quiz. Add questions to the draft version, grade them in preview, then publish when the quiz reflects the current lesson. Each lesson can support one active quiz at a time.
    </p>
  </section>

  <section class="section-tight">
    <div class="section-head section-head-inline">
      <h2>Attempt review</h2>
      <a class="link-arrow" href="/admin/attempts">Review attempts</a>
    </div>
    <p class="muted">
      Submitted and expired attempts appear here, newest first. Scores are graded server-side at submission and locked once submitted — attempt review is read-only and cannot change results.
    </p>
  </section>

  <section class="panel panel-muted section-tight">
    <h2>Administrator responsibilities</h2>
    <ul class="roadmap">
      <li>Provision the first administrator with <code>npm run create-admin -- --email you@example.com</code>.</li>
      <li>Disable an account instead of deleting it, so assessment history stays intact.</li>
      <li>Never share quiz answer keys or student email addresses outside the institution.</li>
      <li>Keep <code>.env</code> out of version control, and rotate the OAuth client secret and refresh tokens if they are ever exposed.</li>
    </ul>
  </section>
  </main>

<%- include('../partials/footer') %>
