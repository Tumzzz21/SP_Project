<%- include('partials/head') %>

<main id="main" class="auth-shell">
  <div class="auth-card">
    <p class="eyebrow">Create your account</p>
    <h1>Join CyberSafe</h1>
    <p class="muted auth-intro">
      Register with your email and a password, then choose a username on the next
      step. Student accounts only — administrators are provisioned separately.
    </p>

    <%- include('partials/flash') %>

    <form method="post" action="/auth/register" class="form-stack auth-form" data-pending-form novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">

      <label class="field<%= errors.email ? ' field-invalid' : '' %>">
        <span class="field-label">Email Address</span>
        <input
          type="email"
          name="email"
          value="<%= values.email %>"
          placeholder="e.g. your.email@example.com"
          autocomplete="email"
          maxlength="254"
          required
          autofocus
          aria-describedby="<%= errors.email ? 'register-email-error' : undefined %>"
        >
        <% if (errors.email) { %>
          <span class="field-error" id="register-email-error"><%= errors.email %></span>
        <% } %>
      </label>

      <div class="field<%= errors.password ? ' field-invalid' : '' %>">
        <label class="field-label" for="register-password">Password</label>
        <div class="password-wrap">
          <input
            id="register-password"
            type="password"
            name="password"
            autocomplete="new-password"
            minlength="8"
            maxlength="200"
            required
            aria-describedby="<%= errors.password ? 'register-password-error' : 'register-password-help' %>"
          >
          <button
            type="button"
            class="password-toggle"
            data-toggle-password="register-password"
            aria-label="Show password"
            aria-pressed="false"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M12 5c-5 0-8.7 3.6-10 7 1.3 3.4 5 7 10 7s8.7-3.6 10-7c-1.3-3.4-5-7-10-7zm0 11.5A4.5 4.5 0 1 1 12 7.5a4.5 4.5 0 0 1 0 9zm0-2a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"/>
            </svg>
          </button>
        </div>
        <% if (errors.password) { %>
          <span class="field-error" id="register-password-error"><%= errors.password %></span>
        <% } else { %>
          <span class="field-help" id="register-password-help">At least 8 characters. Stored only as a salted hash.</span>
        <% } %>
      </div>

      <div class="field<%= errors.confirmPassword ? ' field-invalid' : '' %>">
        <label class="field-label" for="register-confirm">Confirm Password</label>
        <div class="password-wrap">
          <input
            id="register-confirm"
            type="password"
            name="confirmPassword"
            autocomplete="new-password"
            minlength="8"
            maxlength="200"
            required
            aria-describedby="<%= errors.confirmPassword ? 'register-confirm-error' : undefined %>"
          >
          <button
            type="button"
            class="password-toggle"
            data-toggle-password="register-confirm"
            aria-label="Show password"
            aria-pressed="false"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M12 5c-5 0-8.7 3.6-10 7 1.3 3.4 5 7 10 7s8.7-3.6 10-7c-1.3-3.4-5-7-10-7zm0 11.5A4.5 4.5 0 1 1 12 7.5a4.5 4.5 0 0 1 0 9zm0-2a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"/>
            </svg>
          </button>
        </div>
        <% if (errors.confirmPassword) { %>
          <span class="field-error" id="register-confirm-error"><%= errors.confirmPassword %></span>
        <% } %>
      </div>

      <button class="btn btn-dark btn-block" type="submit">Create Account</button>
    </form>

    <% if (googleConfigured) { %>
      <div class="auth-divider" role="separator" aria-label="or continue with"><span>or</span></div>

      <a class="btn btn-google btn-block" href="/auth/google/start">
        <svg class="google-mark" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.4a5.5 5.5 0 0 1-2.4 3.6v3h3.9c2.3-2.1 3.6-5.2 3.6-8.8z"/>
          <path fill="#34A853" d="M12 24c3.2 0 5.9-1.1 7.9-2.9l-3.9-3c-1 .7-2.3 1.1-4 1.1a7 7 0 0 1-6.6-4.8H1.4v3.1A12 12 0 0 0 12 24z"/>
          <path fill="#FBBC05" d="M5.4 14.4a7.2 7.2 0 0 1 0-4.8V6.5H1.4a12 12 0 0 0 0 11l4-3.1z"/>
          <path fill="#EA4335" d="M12 4.8c1.8 0 3.4.6 4.6 1.8l3.4-3.4A12 12 0 0 0 1.4 6.5l4 3.1A7 7 0 0 1 12 4.8z"/>
        </svg>
        Continue with Google
      </a>
    <% } %>

    <p class="auth-footer auth-links">
      <span class="auth-links-row">
        Already have an account?
        <a class="auth-link" href="/login">Sign in</a>
      </span>
      <a class="auth-link auth-link-subtle" href="/admin-login">
        Administrator access? (Separate login)
      </a>
    </p>
  </div>
</main>

<script src="/js/auth.js" defer></script>
<%- include('partials/footer') %>
