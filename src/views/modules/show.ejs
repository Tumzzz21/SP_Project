<%- include('../partials/head') %>

<main id="main" class="shell page">
  <%- include('../partials/flash') %>

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/modules">Modules</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page"><%= module.title %></span>
  </nav>

  <header class="module-header">
    <div>
      <p class="eyebrow">Module</p>
      <h1><%= module.title %></h1>
      <p class="muted"><%= module.description %></p>
    </div>
    <div class="module-progress">
      <div class="meter" role="progressbar" aria-valuenow="<%= progress.percent %>" aria-valuemax="100" aria-label="<%= progress.percent %>% complete">
        <span class="meter-fill" style="width: <%= progress.percent %>%"></span>
      </div>
      <p class="muted"><%= progress.completed %> of <%= progress.total %> items complete (<%= progress.percent %>%)</p>
    </div>
  </header>

  <div class="module-layout">
    <aside class="module-sidebar" aria-label="Module contents">
      <h2 class="module-sidebar-title">Contents</h2>
      <ol class="module-toc">
        <% items.forEach(function (item, idx) { %>
          <li class="module-toc-item<%= item.completed ? ' is-complete' : '' %>">
            <a href="#" class="module-toc-link mv-toc-link" data-idx="<%= idx %>">
              <span class="module-toc-num"><%= idx + 1 %></span>
              <span class="module-toc-text"><%= item.title %></span>
              <span class="badge badge-<%= item.type === 'quiz' ? 'warning' : 'outline' %>"><%= item.type.toUpperCase() %></span>
              <% if (item.completed) { %><span class="badge badge-success">Done</span><% } %>
            </a>
          </li>
        <% }); %>
      </ol>
    </aside>

    <section class="module-content" aria-label="Module content">
      <div class="doc-toolbar">
        <span class="doc-counter" id="mv-counter">Page 1 of <%= items.length %></span>
        <div class="doc-actions">
          <button class="btn btn-ghost btn-sm" type="button" id="mv-prev" aria-label="Previous">‹</button>
          <button class="btn btn-ghost btn-sm" type="button" id="mv-next" aria-label="Next">›</button>
          <button class="btn btn-ghost btn-sm" type="button" id="mv-fullscreen" aria-label="Full screen"> ( ) </button>
          <a class="btn btn-secondary btn-sm" id="mv-download" href="#" aria-label="Download">Download</a>
        </div>
      </div>

      <% items.forEach(function (item, idx) { %>
        <article class="mv-page content-card" <%= idx === 0 ? '' : 'hidden' %> data-file="<%= item.type === 'file' ? '/files/' + item.file_path.split('/').pop() : '' %>" data-type="<%= item.type %>">
          <header class="content-card-head">
            <h2><%= item.title %></h2>
            <span class="badge badge-<%= item.type === 'quiz' ? 'warning' : 'outline' %>"><%= item.type.toUpperCase() %></span>
            <% if (item.completed) { %><span class="badge badge-success">Done</span><% } %>
          </header>
          <div class="content-card-body">
            <% if (item.type === 'page') { %>
              <div class="module-page-content"><%- item.content %></div>
            <% } else if (item.type === 'link') { %>
              <a href="<%= item.url %>" target="_blank" rel="noopener noreferrer" class="link-arrow">Open link →</a>
            <% } else if (item.type === 'file') { %>
              <% const isPdf = item.file_name && item.file_name.toLowerCase().endsWith('.pdf'); %>
              <% if (isPdf) { %>
                <iframe src="/files/<%= item.file_path.split('/').pop() %>" class="doc-viewer" title="<%= item.title %>"></iframe>
              <% } else { %>
                <p class="muted">Preview not available for this file type. Use Download.</p>
              <% } %>
            <% } else if (item.type === 'quiz') { %>
              <a href="/quizzes" class="link-arrow">Take quiz →</a>
            <% } %>
          </div>
          <% if (!item.completed) { %>
            <form method="post" action="/modules/<%= module.id %>/items/<%= item.id %>/complete" class="content-card-actions">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-primary btn-sm" type="submit">Mark complete</button>
            </form>
          <% } else { %>
            <div class="content-card-actions"><span class="badge badge-success">Completed</span></div>
          <% } %>
        </article>
      <% }); %>
    </section>
  </div>

  <% if (quizzes && quizzes.length > 0) { %>
    <section class="module-quizzes" aria-labelledby="module-quizzes-title">
      <div class="section-head">
        <h2 id="module-quizzes-title">Quizzes in this module</h2>
        <p class="muted">Check what you learned — results are saved to your history.</p>
      </div>
      <ul class="module-quiz-list">
        <% quizzes.forEach(function (quiz) { %>
          <li class="module-quiz-card">
            <div class="module-quiz-info">
              <h3><a href="/quizzes/<%= quiz.slug %>"><%= quiz.title %></a></h3>
              <p class="muted"><%= quiz.description || 'A short knowledge check.' %></p>
              <p class="muted small">Version <%= quiz.version %> · passing score <%= quiz.passingScorePercent %>%</p>
            </div>
            <a class="btn btn-primary btn-sm" href="/quizzes/<%= quiz.slug %>">Start quiz</a>
          </li>
        <% }); %>
      </ul>
    </section>
  <% } %>

  <div class="page-actions">
    <a class="btn btn-secondary" href="/modules">Back to modules</a>
  </div>
</main>
<script src="/js/module-viewer.js" defer></script>
<%- include('../partials/footer') %>
