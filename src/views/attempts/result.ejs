<%- include('../partials/head') %>

<main id="main" class="shell page">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/quizzes">Quizzes</a>
    <span aria-hidden="true">/</span>
    <a href="/quizzes/history">History</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">Result</span>
  </nav>

  <%- include('../partials/flash') %>

  <header class="page-head">
    <div>
      <p class="eyebrow">Quiz result · Version <%= quiz.version %></p>
      <h1><%= quiz.title %></h1>
    </div>
  </header>

  <section class="panel result-summary" aria-label="Score summary">
    <div>
      <p class="stat-label">Your score</p>
      <p class="result-score"><%= attempt.scorePoints %><span> / <%= attempt.maxPoints %></span></p>
      <p class="result-percent"><%= percentage %>%</p>
      <% const passMark = (typeof quiz.passingScorePercent === 'number') ? quiz.passingScorePercent : 0; %>
      <% if (percentage >= passMark) { %>
        <span class="chip chip-pass">Passed</span>
      <% } else { %>
        <span class="chip chip-fail">Not passed</span>
      <% } %>
      <p class="muted">Submitted <%= formatDateTime(attempt.submittedAt) %>.</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="section-head">
      <h2>Review and explanations</h2>
      <p class="muted">Your selection is shown first, then the correct answer and why it is correct.</p>
    </div>

    <% answers.forEach(function (answer, i) { %>
      <div class="quiz-card" style="margin-bottom:1rem;">
        <h2>Question <%= i + 1 %></h2>
        <p><%= answer.prompt %></p>
        <% (answer.options || []).forEach(function (option) { %>
          <label class="option-row" style="pointer-events:none;">
            <input type="radio" disabled <%= answer.selectedOptionId === option.id ? 'checked' : '' %>>
            <span class="option-circle" aria-hidden="true"></span>
            <span class="option-text"><%= option.label %></span>
            <% if (answer.selectedOptionId === option.id) { %>
              <% if (answer.isCorrect === 1) { %>
                <span class="chip chip-pass">Correct</span>
              <% } else { %>
                <span class="chip chip-fail">Incorrect</span>
              <% } %>
            <% } %>
            <% if (answer.selectedOptionId !== option.id && option.id === answer.correctOptionId) { %>
              <span class="chip chip-pass">Correct answer</span>
            <% } %>
          </label>
        <% }); %>
        <% if (answer.selectedOptionId === null) { %>
          <p class="muted" style="color:var(--accent-amber);">Not answered</p>
        <% } %>
        <div class="explanation-box">
          <p><strong>Why:</strong> <%= answer.explanation %></p>
        </div>
      </div>
    <% }); %>
  </section>

  <div class="page-actions">
    <% if (canRetry && latestPublished) { %>
      <form method="post" action="/quizzes/<%= latestPublished.slug %>/attempt" data-pending-form>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-primary" type="submit">Try again</button>
      </form>
    <% } %>
    <a class="btn btn-secondary" href="/quizzes">Back to quizzes</a>
    <a class="btn btn-secondary" href="/quizzes/history">View history</a>
  </div>
</main>
<%- include('../partials/footer') %>
