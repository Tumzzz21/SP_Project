<%- include('partials/head') %>

<main id="main" class="auth-shell">
  <div class="auth-card">
    <p class="eyebrow">Account recovery</p>
    <h1>Reset your password</h1>
    <p class="muted auth-intro">
      Enter the email address you registered with.
    </p>

    <%- include('partials/flash') %>

    <form method="post" action="/auth/forgot-password" class="form-stack auth-form" data-pending-form novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">

      <label class="field<%= errors.email ? ' field-invalid' : '' %>">
        <span class="field-label">Email Address</span>
        <input
          type="email"
          name="email"
          value="<%= values.email %>"
          placeholder="e.g. your.email@example.com"
          autocomplete="email"
          maxlength="254"
          required
          autofocus
          aria-describedby="<%= errors.email ? 'reset-email-error' : undefined %>"
        >
        <% if (errors.email) { %>
          <span class="field-error" id="reset-email-error"><%= errors.email %></span>
        <% } %>
      </label>

      <button class="btn btn-dark btn-block" type="submit">Send reset instructions</button>
    </form>

    <p class="auth-footer auth-links">
      <span class="auth-links-row">
        Remembered it?
        <a class="auth-link" href="/login">Back to sign in</a>
      </span>
    </p>
  </div>
</main>

<%- include('partials/footer') %>
