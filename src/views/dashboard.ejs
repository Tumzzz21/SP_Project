<%- include('partials/head') %>

<main id="main" class="shell page">
  <%- include('partials/flash') %>

  <header class="dash-page-header">
    <h1 class="dash-title"><%= user.role === 'admin' ? 'Your learning' : 'Welcome back, ' + user.displayName %></h1>
    <a class="btn btn-primary btn-sm" href="/modules">Continue modules</a>
  </header>
  <div class="dash-divider" role="separator"></div>

  <!-- Hero: continue where you left off -->
  <p class="dash-eyebrow">Continue where you left off</p>
  <% if (modules.length === 0) { %>
    <section class="dash-hero dash-hero-empty" aria-label="No modules published">
      <div class="dash-hero-inner">
        <h2 class="dash-hero-heading">No modules published yet</h2>
        <p class="dash-hero-sub">Check back soon — your instructor publishes modules as they become ready.</p>
      </div>
    </section>
  <% } else if (nextItem && nextModule) { %>
    <section class="dash-hero" aria-label="Continue where you left off">
      <div class="dash-hero-inner">
        <p class="dash-hero-module">
          <span class="dash-hero-module-icon" aria-hidden="true"><%- include('partials/icon', { name: 'modules', size: 16 }) %></span>
          <%= nextModule.title %>
        </p>
        <h2 class="dash-hero-heading"><%= nextItem.title %></h2>
        <p class="dash-hero-sub"><%= nextItem.type ? nextItem.type.charAt(0).toUpperCase() + nextItem.type.slice(1) : 'Item' %> in <%= nextModule.title %> — your next unfinished item.</p>
        <a class="btn btn-primary btn-hero" href="/modules/<%= nextModule.id %>">
          Continue <%- include('partials/icon', { name: 'arrow', size: 16 }) %>
        </a>
      </div>
    </section>
  <% } else { %>
    <section class="dash-hero dash-hero-done" aria-label="All complete">
      <div class="dash-hero-inner">
        <p class="dash-hero-module">
          <span class="dash-hero-module-icon" aria-hidden="true"><%- include('partials/icon', { name: 'check', size: 16 }) %></span>
          All modules complete
        </p>
        <h2 class="dash-hero-heading">You've finished all modules</h2>
        <p class="dash-hero-sub">Revisit any module to review it, or try a quiz.</p>
        <a class="btn btn-secondary btn-hero" href="/quizzes">Take a quiz <%- include('partials/icon', { name: 'arrow', size: 16 }) %></a>
      </div>
    </section>
  <% } %>

  <!-- Stats row -->
  <section class="dash-stats" aria-label="Your progress">
    <div class="stat-card">
      <div class="stat-head">
        <p class="stat-label">Modules completed</p>
        <span class="stat-icon" aria-hidden="true"><%- include('partials/icon', { name: 'modules', size: 18 }) %></span>
      </div>
      <p class="stat-value"><%= completedModules %><span class="stat-suffix"> / <%= modules.length %></span></p>
      <p class="stat-caption">Finished modules across published content.</p>
    </div>

    <div class="stat-card">
      <div class="stat-head">
        <p class="stat-label">Overall progress</p>
        <span class="stat-icon" aria-hidden="true"><%- include('partials/icon', { name: 'progress', size: 18 }) %></span>
      </div>
      <p class="stat-value"><%= overallPercent %><span class="stat-suffix">%</span></p>
      <div class="meter" aria-label="Module completion" role="progressbar" aria-valuenow="<%= overallPercent %>" aria-valuemin="0" aria-valuemax="100">
        <progress class="meter-fill" value="<%= overallPercent %>" max="100" aria-hidden="true"></progress>
      </div>
      <p class="stat-caption"><%= completedItems %> of <%= totalItems %> item<%= totalItems === 1 ? '' : 's' %> complete.</p>
    </div>

    <div class="stat-card">
      <div class="stat-head">
        <p class="stat-label">Best quiz score</p>
        <span class="stat-icon" aria-hidden="true"><%- include('partials/icon', { name: 'trophy', size: 18 }) %></span>
      </div>
      <% if (historySummary.bestPercentage === null || historySummary.bestPercentage === undefined) { %>
        <p class="stat-value">---</p>
        <p class="stat-caption">Finish a quiz to see a score here.</p>
      <% } else { %>
        <p class="stat-value"><%= historySummary.bestPercentage %><span class="stat-suffix">%</span></p>
        <p class="stat-caption">Last submitted <%= formatDate(historySummary.lastAttemptAt) %>.</p>
      <% } %>
    </div>
  </section>
  <!--SPLIT-->
  <!-- Lower section: 60/40 -->
  <section class="dash-lower">
    <div class="dash-modules">
      <h2 class="dash-section-title">Your modules</h2>
      <% if (modules.length === 0) { %>
        <div class="empty-state empty-state-compact empty-state--secure">
          <span class="empty-illustration" aria-hidden="true"><%- include('partials/icon', { name: 'shieldSearch', size: 40 }) %></span>
          <h3>No modules are published yet</h3>
          <p>Check back soon — your instructor publishes modules as they become ready.</p>
        </div>
      <% } else { %>
        <div class="dash-mod-list">
          <% modules.forEach(function (m) { %>
            <a href="/modules/<%= m.id %>" class="dash-mod-row">
              <span class="dash-mod-icon" aria-hidden="true"><%- include('partials/icon', { name: 'modules', size: 18 }) %></span>
              <span class="dash-mod-title"><%= m.title %></span>
              <span class="dash-mod-meta"><%= m.progress.percent %>% · <%= m.progress.completed %> / <%= m.progress.total %> item<%= m.progress.total === 1 ? '' : 's' %></span>
              <span class="dash-mod-bar meter" role="progressbar" aria-label="<%= m.progress.percent %>% complete" aria-valuenow="<%= m.progress.percent %>" aria-valuemin="0" aria-valuemax="100">
                <progress class="meter-fill" value="<%= m.progress.percent %>" max="100" aria-hidden="true"></progress>
              </span>
            </a>
          <% }); %>
        </div>
      <% } %>
    </div>

    <div class="dash-quizzes">
      <h2 class="dash-section-title">Your recent quizzes</h2>
      <div class="card">
        <%- include('partials/quiz-attempts-list', { attempts: recentAttempts, scope: 'mine', emptyTitle: 'No quiz attempts yet.', emptyMessage: 'Quizzes are short checks with explanations. Your results will appear here after you submit one.', ctaHref: '/quizzes', ctaLabel: 'Browse quizzes' }) %>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>