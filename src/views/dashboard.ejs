<%- include('partials/head') %>

<main id="main" class="shell page">
  <%- include('partials/flash') %>

  <header class="page-head">
    <div>
      <p class="eyebrow eyebrow-shield"><%- include('partials/icon', { name: 'shield', size: 14 }) %> <%= user.role === 'admin' ? 'Admin dashboard' : 'Student dashboard' %></p>
      <h1><%= user.role === 'admin' ? 'Your learning' : 'Welcome back, ' + user.displayName %></h1>
      <p class="muted">
        Pick up where you left off. Signed in as <strong><%= user.username %></strong> (<%= user.email %>).
      </p>
    </div>
    <div class="page-head-actions">
      <a class="btn btn-primary" href="/modules">Open Modules</a>
      <% if (user.role === 'admin') { %>
        <a class="btn btn-secondary" href="/admin">Admin Console</a>
      <% } %>
    </div>
  </header>

  <% if (nextItem && nextModule) { %>
    <section class="continue-hero" aria-label="Continue where you left off">
      <div class="continue-hero-body">
        <div class="continue-hero-meta">
          <p class="eyebrow">Continue where you left off</p>
          <span class="tag-pill"><%- include('partials/icon', { name: 'modules', size: 13 }) %> <%= nextModule.title %></span>
        </div>
        <h2><%= nextItem.title %></h2>
        <p class="muted continue-hero-summary"><%= nextItem.type ? nextItem.type.charAt(0).toUpperCase() + nextItem.type.slice(1) : 'Item' %> in <%= nextModule.title %> — your next unfinished item.</p>
        <a class="btn btn-primary btn-hero" href="/modules/<%= nextModule.id %>">
          Continue <%- include('partials/icon', { name: 'arrow', size: 16 }) %>
        </a>
      </div>
    </section>
  <% } else if (modules.length > 0) { %>
    <section class="continue-hero continue-hero-done" aria-label="All complete">
      <div class="continue-hero-body">
        <div class="continue-hero-meta">
          <p class="eyebrow">All caught up</p>
          <span class="tag-pill tag-pill--done"><%- include('partials/icon', { name: 'check', size: 13 }) %> Everything complete</span>
        </div>
        <h2>All module items complete</h2>
        <p class="muted continue-hero-summary">Revisit any module to review it.</p>
        <a class="btn btn-secondary btn-hero" href="/modules">Review modules <%- include('partials/icon', { name: 'arrow', size: 16 }) %></a>
      </div>
    </section>
  <% } %>

  <section class="stat-grid" aria-label="Your progress">
    <div class="stat-card stat-card--green">
      <div class="stat-head">
        <span class="stat-icon" aria-hidden="true"><%- include('partials/icon', { name: 'modules', size: 20 }) %></span>
        <p class="stat-label">Modules completed</p>
      </div>
      <p class="stat-value"><%= completedModules %><span class="stat-suffix">/<%= modules.length %></span></p>
      <p class="muted">Finished modules across published content.</p>
    </div>

    <div class="stat-card stat-card--cyan">
      <div class="stat-head">
        <span class="stat-icon" aria-hidden="true"><%- include('partials/icon', { name: 'progress', size: 20 }) %></span>
        <p class="stat-label">Overall progress</p>
      </div>
      <p class="stat-value"><%= overallPercent %><span class="stat-suffix">%</span></p>
      <div class="meter" aria-label="Module completion" role="img" aria-valuenow="<%= overallPercent %>" aria-valuemin="0" aria-valuemax="100">
        <progress class="meter-fill" value="<%= overallPercent %>" max="100" aria-hidden="true"></progress>
      </div>
      <p class="muted"><%= completedItems %> of <%= totalItems %> item<%= totalItems === 1 ? '' : 's' %> complete.</p>
    </div>

    <div class="stat-card stat-card--blue">
      <div class="stat-head">
        <span class="stat-icon" aria-hidden="true"><%- include('partials/icon', { name: 'trophy', size: 20 }) %></span>
        <p class="stat-label">Best quiz score</p>
      </div>
      <% if (historySummary.bestPercentage === null || historySummary.bestPercentage === undefined) { %>
        <p class="stat-value">—</p>
        <p class="muted">Finish a quiz to see a score here.</p>
      <% } else { %>
        <p class="stat-value"><%= historySummary.bestPercentage %><span class="stat-suffix">%</span></p>
        <p class="muted">Last submitted <%= formatDate(historySummary.lastAttemptAt) %>.</p>
      <% } %>
    </div>
  </section>
    <section class="section-tight">
    <div class="section-head-inline">
      <h2>Your modules</h2>
      <a class="link-arrow" href="/modules">All modules <span aria-hidden="true">&rarr;</span></a>
    </div>
    <% if (modules.length === 0) { %>
      <div class="empty-state">
        <h3>No modules are published yet</h3>
        <p>Check back soon - your instructor publishes modules as they become ready.</p>
      </div>
    <% } else { %>
      <ul class="module-list-compact">
        <% modules.forEach(function (m) { %>
          <li>
            <a href="/modules/<%= m.id %>" class="module-row">
              <span class="module-row-title"><%= m.title %></span>
              <span class="module-row-meta muted"><%= m.progress.completed %>/<%= m.progress.total %> item<%= m.progress.total === 1 ? '' : 's' %></span>
              <span class="meter meter--sm" aria-label="<%= m.progress.percent %>% complete">
                <progress class="meter-fill" value="<%= m.progress.percent %>" max="100" aria-hidden="true"></progress>
              </span>
              <span class="module-row-pct"><%= m.progress.percent %>%</span>
            </a>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </section>

  <section class="split section-tight">
    <div class="panel">
      <div class="section-head-inline">
        <h2>Your recent quizzes</h2>
        <a class="link-arrow" href="/quizzes/history">Full history <span aria-hidden="true">&rarr;</span></a>
      </div>
      <%- include('partials/quiz-attempts-list', { attempts: recentAttempts, scope: 'mine', emptyTitle: 'No quiz attempts yet', emptyMessage: 'Quizzes are short checks with explanations. Your results will appear here after you submit one.', ctaHref: '/quizzes', ctaLabel: 'Browse quizzes' }) %>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
