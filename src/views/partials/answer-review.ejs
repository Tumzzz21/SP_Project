<%# One reviewed question: the student's selection, the correct answer, and why. %>
<%# Locals: answer (graded answer row with options/correctOptionId), index (0-based). %>
<% const options = answer.options || []; %>
<div class="quiz-card" style="margin-bottom:1rem;" data-answer-review data-question-id="<%= answer.questionId %>">
  <h2>Question <%= index + 1 %></h2>
  <p><%= answer.prompt %></p>
  <% if (options.length > 0) { %>
    <% options.forEach(function (option, optionIndex) { %>
      <label class="option-row" style="pointer-events:none;">
        <input type="radio" disabled <%= answer.selectedOptionId === option.id ? 'checked' : '' %>>
        <span class="option-badge option-letter" aria-hidden="true"><%= String.fromCharCode(65 + optionIndex) %></span>
        <span class="option-text"><%= option.label %></span>
        <% if (answer.selectedOptionId === option.id) { %>
          <% if (answer.isCorrect === 1) { %>
            <span class="chip chip-pass">Correct</span>
          <% } else { %>
            <span class="chip chip-fail">Incorrect</span>
          <% } %>
        <% } %>
        <% if (answer.selectedOptionId !== option.id && option.id === answer.correctOptionId) { %>
          <span class="chip chip-pass">Correct answer</span>
        <% } %>
      </label>
    <% }); %>
  <% } else { %>
    <%# Fallback when the option list is unavailable: never drop the choices. %>
    <div class="answer-fallback">
      <p><strong>Selected answer:</strong> <%= answer.selectedLabel || '— (no answer selected)' %></p>
      <p><strong>Correct answer:</strong> <%= answer.correctLabel || '—' %></p>
    </div>
  <% } %>
  <% if (answer.selectedOptionId === null || answer.selectedOptionId === undefined) { %>
    <p class="muted" style="color:var(--accent-amber);">Not answered</p>
  <% } %>
  <% if (answer.explanation) { %>
    <div class="explanation-box">
      <p><strong>Why:</strong> <%= answer.explanation %></p>
    </div>
  <% } %>
</div>
