<%
  const tab = typeof adminTab === 'string' ? adminTab : '';
  const tabs = [
    { key: 'overview', label: 'Overview', href: '/admin' },
    { key: 'students', label: 'Students', href: '/admin/students' },
    { key: 'attempts', label: 'Attempt review', href: '/admin/attempts' },
  ];
%>
<nav class="filter-bar" aria-label="Admin sections">
  <% tabs.forEach(function (item) { %>
    <a
      class="chip<%= tab === item.key ? ' is-active' : '' %>"
      href="<%= item.href %>"
    <% if (tab === item.key) { %> aria-current="page"<% } %>><%= item.label %></a>
  <% }); %>
</nav>