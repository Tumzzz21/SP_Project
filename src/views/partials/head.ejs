<!DOCTYPE html>
<html lang="<%= user ? (user.language || 'en') : 'en' %>" class="lang-<%= user ? (user.language || 'en') : 'en' %> text-<%= user ? (user.text_size || 'medium') : 'medium' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %></title>
  <meta name="description" content="CyberSafe is a cybersecurity awareness website that helps students recognise phishing, build stronger passwords, avoid online scams, protect personal data, and use the internet responsibly.">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="<%= bodyClass %>">
  <a class="skip-link" href="#main">Skip to main content</a>

  <header class="site-header">
    <div class="shell header-inner">
      <a class="brand" href="<%= user ? (user.role === 'admin' ? '/admin' : '/dashboard') : '/login' %>">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3l7 3v6c0 4.2-2.9 7.6-7 9-4.1-1.4-7-4.8-7-9V6l7-3z"/>
            <path d="M9 12.2l2.1 2.1L15 10.6"/>
          </svg>
        </span>
        <span class="brand-name">CyberSafe</span>
      </a>

      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" data-nav-toggle>
        <span class="nav-toggle-bar" aria-hidden="true"></span>
        <span class="nav-toggle-bar" aria-hidden="true"></span>
        <span class="nav-toggle-bar" aria-hidden="true"></span>
        <span class="sr-only">Toggle navigation</span>
      </button>

      <nav class="primary-nav" id="primary-nav" aria-label="Primary">
        <% if (!user) { %>
                  <a class="nav-cta" href="/login">Sign in</a>
        <% } else { %>
          <% if (user.role === 'admin') { %>
            <a href="/dashboard" class="<%= activeNav === 'dashboard' ? 'is-active' : '' %>"<%= activeNav === 'dashboard' ? ' aria-current="page"' : '' %>>Dashboard</a>
            <a href="/modules" class="<%= activeNav === 'modules' ? 'is-active' : '' %>"<%= activeNav === 'modules' ? ' aria-current="page"' : '' %>>Modules</a>
            <a href="/quizzes" class="<%= activeNav === 'quizzes' ? 'is-active' : '' %>"<%= activeNav === 'quizzes' ? ' aria-current="page"' : '' %>>Quizzes</a>
            <a href="/admin" class="<%= activeNav === 'admin' ? 'is-active' : '' %>"<%= activeNav === 'admin' ? ' aria-current="page"' : '' %>>Admin</a>
          <% } else { %>
            <a href="/dashboard" class="<%= activeNav === 'dashboard' ? 'is-active' : '' %>"<%= activeNav === 'dashboard' ? ' aria-current="page"' : '' %>>Dashboard</a>
            <a href="/modules" class="<%= activeNav === 'modules' ? 'is-active' : '' %>"<%= activeNav === 'modules' ? ' aria-current="page"' : '' %>>Modules</a>
            <a href="/quizzes" class="<%= activeNav === 'quizzes' ? 'is-active' : '' %>"<%= activeNav === 'quizzes' ? ' aria-current="page"' : '' %>>Quizzes</a>
          <% } %>
          <%
            const avatarName = String(user.displayName || user.username || user.email || '').trim();
            const avatarInitials = avatarName
              ? avatarName.split(/\s+/).slice(0, 2).map(function (part) { return part.charAt(0); }).join('').toUpperCase()
              : '?';
          %>
          <div class="nav-user" data-user-menu>
            <button
              id="nav-avatar-btn"
              class="nav-avatar"
              type="button"
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="nav-user-panel"
              title="<%= avatarName %>"
            >
              <% if (user.avatar_url) { %>
                <img src="<%= user.avatar_url %>" alt="" class="nav-avatar-img" aria-hidden="true">
              <% } else { %>
                <span aria-hidden="true"><%= avatarInitials %></span>
              <% } %>
              <span class="sr-only">Account menu for <%= avatarName %></span>
            </button>

            <div class="profile-menu" id="nav-user-panel">
              <div class="nav-user-head">
                <div class="nav-user-avatar">
                  <% if (user.avatar_url) { %>
                    <img src="<%= user.avatar_url %>" alt="" class="nav-user-avatar-img">
                  <% } else { %>
                    <%= avatarInitials %>
                  <% } %>
                </div>
                <div class="nav-user-info">
                  <p class="nav-user-name"><%= user.displayName %></p>
                  <p class="nav-user-email"><%= user.email %></p>
                </div>
              </div>
              <div class="nav-user-divider" role="separator"></div>
              <a class="nav-user-item" href="/settings/profile">
                <%- include('icon', { name: 'settings', size: 16 }) %>
                <span>Settings</span>
              </a>
              <% if (user.role === 'admin') { %>
                <a class="nav-user-item" href="/admin">
                  <%- include('icon', { name: 'shield', size: 16 }) %>
                  <span>Admin Console</span>
                </a>
              <% } %>
              <div class="nav-user-divider" role="separator"></div>
              <form method="post" action="/auth/logout" class="nav-user-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="nav-user-item nav-user-signout" type="submit">
                  <%- include('icon', { name: 'signOut', size: 16 }) %>
                  <span>Sign Out</span>
                </button>
              </form>
            </div>
          </div>
        <% } %>
      </nav>
    </div>
  </header>
